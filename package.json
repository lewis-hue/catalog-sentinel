{
  "name": "artist-catalog-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Artist Catalog Sentinel - audits an artist's distribution catalog against live DSP/platform catalogs, detects discrepancies, and generates evidence-backed support packets for distributors and DSPs.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run --workspace apps/web typecheck",
    "api": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "web": "npm run dev --workspace apps/web",
    "probe:steel": "tsx scripts/probe-steel.ts",
    "test:a11y": "bash scripts/a11y.sh",
    "test:perf": "bash scripts/perf.sh",
    "lint": "eslint . --max-warnings 0 && npm run --workspace apps/web lint",
    "format": "prettier --check . || echo 'prettier not configured; skipping'",
    "test:infra": "node scripts/test-with-infra.mjs",
    "accept:credentials": "tsx scripts/production-credential-acceptance.ts",
    "accept:distrokid": "node scripts/authorized-distrokid-acceptance.mjs",
    "loadtest:production": "node scripts/production-soak.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
