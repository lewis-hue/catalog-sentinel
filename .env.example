# Artist Catalog Sentinel - fail-closed production environment template
#
# Copy only for a production-like deployment. Empty values are intentional: this
# file contains no usable credentials or default secrets. Inject secrets from the
# deployment platform and never commit the resulting .env file.
#
# Local and production-like deployments both require real durable services, Keycloak,
# and Steel. Automated tests provide their own isolated doubles and never read this file.

# Runtime and public origins
NODE_ENV=production
DEPLOYMENT_ENV=production
LOG_LEVEL=info
APP_BASE_URL=
API_PROXY_TARGET=http://scanner:4000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
SENTINEL_IMAGE=
SCANNER_MEMORY_LIMIT=1g
SCANNER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=2g
WORKER_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=1.0
MIGRATE_MEMORY_LIMIT=1g
MIGRATE_CPU_LIMIT=1.0

# Durable data and queues (required in production). All three URLs target the same database but
# use separately provisioned roles; only MIGRATION_DATABASE_URL may own/alter schema objects.
API_DATABASE_URL=
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=
# Direct process launches set DATABASE_URL to the role-appropriate URL above. Compose maps it per
# service. Leave the deprecated SCAN_DATABASE_URL alias unset.
DATABASE_URL=
REDIS_URL=
DEEP_SCAN_DISPATCH=bullmq
SEARCH_STORE_PREFIX=sentinel:production:search
CONNECT_SESSION_PREFIX=sentinel:production:connect-session
# API handoff claims are visibility-leased and reconciled after replica crashes.
CONNECT_CLAIM_VISIBILITY_TIMEOUT_MS=60000
CONNECT_SESSION_RECOVERY_INTERVAL_MS=15000
CONNECT_SESSION_RECOVERY_BATCH_SIZE=50
CONNECT_CONSENT_CANCEL_BATCH_SIZE=100
# Postgres outbox recovery for consent-triggered Steel termination.
CONSENT_REVOCATION_RECOVERY_INTERVAL_MS=10000
CONSENT_REVOCATION_RECOVERY_BATCH_SIZE=50
CONSENT_REVOCATION_LEASE_MS=30000

# Production session encryption. API and workers must use the same symmetric
# ENCRYPT_DECRYPT KMS key, region, and encryption context. Workload identity must
# grant kms:Encrypt and kms:Decrypt; CloudHSM custom key-store keys use this path too.
# Full key ARN only (not an alias or bare key id), pinned to AWS_REGION.
KMS_KEY_ID=
AWS_REGION=
KMS_ENCRYPTION_CONTEXT={"application":"artist-catalog-sentinel","environment":"production","purpose":"session-envelope"}
KMS_REQUEST_TIMEOUT_MS=5000
KMS_MAX_ATTEMPTS=3
# Separate 32-byte base64 secret for local HMAC signing of history cursors.
HISTORY_CURSOR_SIGNING_KEY=
# Development/test only. Production startup rejects this local master-key path.
ENCRYPTION_MASTER_KEY=
# Optional LocalStack/emulator endpoint for tests only; forbidden in production.
KMS_ENDPOINT=

# Keycloak / OIDC with Authorization Code + PKCE (required in production)
WEB_AUTH_MODE=keycloak
ENABLE_KEYCLOAK_AUTH=true
KEYCLOAK_BASE_URL=
KEYCLOAK_PUBLIC_BASE_URL=
KEYCLOAK_ISSUER=
KEYCLOAK_REALM=sentinel
KEYCLOAK_WEB_CLIENT_ID=
KEYCLOAK_API_CLIENT_ID=
KEYCLOAK_API_AUDIENCE=
# Production uses a confidential BFF client plus PKCE. Inject this secret only into
# the server-side web process; never expose it through a NEXT_PUBLIC_* variable.
KEYCLOAK_WEB_CLIENT_SECRET=
KEYCLOAK_WEB_SCOPE=openid profile email

# Steel sessions - the sole real browser path
BROWSER_LINK_PROVIDER=steel
STEEL_REQUIRED=true
# cloud | external | self_hosted
STEEL_CONNECTOR_MODE=cloud
STEEL_API_KEY=
STEEL_API_URL=
STEEL_CDP_INTERNAL=
# Required production capacity inputs. Steel cannot extend an active lease; use
# values proven by a worst-case load test for the selected Steel plan/deployment.
STEEL_SESSION_TIMEOUT_MS=
CATALOG_READ_MAX_RELEASES=
# Bounded catalogue-index pagination budget. 500 supports large incrementally rendered indexes
# while still failing closed before a broken page can loop indefinitely.
CATALOG_INDEX_MAX_SCROLL_ROUNDS=500
# Bounded Steel REST create/release request (100..60000 ms).
STEEL_API_REQUEST_TIMEOUT_MS=10000
# Redis-backed per-principal API controls (also keep edge/WAF limits).
STEEL_SESSION_START_RATE_LIMIT=3
STEEL_SESSION_START_RATE_WINDOW_MS=900000
CONSENT_CREATE_RATE_LIMIT=20
CONSENT_CREATE_RATE_WINDOW_MS=3600000
API_RATE_LIMIT_PREFIX=sentinel:production:rate-limit
# Space-separated exact origins allowed to frame the Steel live view; never use *.
STEEL_VIEWER_ORIGINS=
WEB_CSP_CONNECT_ORIGINS=
WEB_CSP_FORM_ACTION_ORIGINS=
WEB_CSP_IMAGE_ORIGINS=

# Live DistroKid scanning - production startup requires both true. Do not change
# them until the named legal/compliance owner has recorded approval.
ENABLE_DISTROKID_LIVE_SCANNER=false
LEGAL_REVIEW_DISTROKID_SCANNER_APPROVED=false
# A current compact RS256 JWS signed by independent legal/privacy/security change
# control. Production refuses live scanning without it; the mutable flags above are
# only operational switches. Keep the private signing key outside this application.
COMPLIANCE_APPROVAL_BUNDLE=
COMPLIANCE_APPROVAL_KEY_ID=
COMPLIANCE_APPROVAL_PUBLIC_KEY_PEM=
COMPLIANCE_APPROVAL_ISSUER=
DATA_RETENTION_DAYS=

# A direct authenticated JSON request is an independent legal gate. Passive
# network observation remains the default even after live scanning is approved.
ENABLE_DISTROKID_DIRECT_JSON_READER=false
LEGAL_REVIEW_DISTROKID_DIRECT_JSON_APPROVED=false

# Unsafe/legacy provider paths are always disabled in production.
ENABLE_BROWSERLESS_PROVIDER=false
ENABLE_HYPERBEAM_PROVIDER=false
ENABLE_KASM_PROVIDER=false
ENABLE_LOCAL_HEADLESS_CONNECTOR=false
ENABLE_HOSTED_CREDENTIAL_FORM=false
ENABLE_LEGACY_DOM_SCANNER=false
ENABLE_DISTRIBUTOR_NETWORK_DEBUG=false

# Bounded catalogue/pipeline execution
CATALOG_READ_CONCURRENCY=2
CATALOG_READ_GOTO_TIMEOUT_MS=30000
CATALOG_READ_CONTENT_TIMEOUT_MS=30000
# No production default: at 750 ms minimum pacing, 1,000 release requests alone
# consume at least 750,000 ms before navigation, parsing, and retry overhead.
CATALOG_READ_MAX_DURATION_MS=
CATALOG_READ_WAIT_UNTIL=commit
DEEP_SCAN_MAX_CONCURRENCY=1
# Decouple scraping from store-presence verification. Default false: the DistroKid scrape does
# NOT auto-run the store check; users trigger it on demand (POST /api/searches/:id/store-check).
# Set true to restore the legacy scrape-then-verify chain.
SCAN_STORE_PRESENCE_AUTO=false
# Missing Lyrics module - store-side lyric verification via LRCLIB (lrclib.net). KEYLESS: leave
# blank to use the public host. Returns plain + synced availability per track; a Musixmatch key is
# not required (their free tier is gated). Optional tuning: LYRICS_LOOKUP_CONCURRENCY (default 4),
# LYRICS_CHECKPOINT_SIZE (10), LYRICS_LOOKUP_TIMEOUT_MS (8000).
LYRICS_VERIFY_BASE_URL=
DEEP_SCAN_MAX_TRACKS_PER_SCAN=20000
DEEP_SCAN_TRACK_CHUNK_SIZE=25
DEEP_SCAN_MAX_DISTINCT_ARTISTS=5000
DSP_CATALOG_MAX_TRACKS_PER_ARTIST=20000
DSP_CATALOG_FETCH_CONCURRENCY=2
DEEP_SCAN_CHECKPOINT_INTERVAL=25
DEEP_SCAN_STREAM_INTERVAL_MS=400
DEEP_SCAN_STREAM_MAX_MS=180000
DISTRIBUTOR_SCAN_MIN_DELAY_MS=1500
DISTRIBUTOR_SCAN_MAX_PAGES_PER_RUN=500
DISTRIBUTOR_SCAN_MAX_RELEASES_PER_RUN=1000

# Official DSP/API integrations. These are application credentials, never artist
# passwords. An absent or capped integration must produce unavailable/unverifiable,
# not a definitive not-live result.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
AUDIOMACK_CONSUMER_KEY=
AUDIOMACK_CONSUMER_SECRET=
AUDIOMACK_PROFILE_URL=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_PROFILE_URL=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_PROFILE_URL=

# Confirmation-only web evidence via Serper (hosted Google SERP API). Sign up at serper.dev
# (2,500 free queries) and set SERPER_API_KEY to enable it. Leave SEARCH_PROVIDER empty for auto
# (Serper when the key is set). Best-effort evidence only, never a source of truth.
ENABLE_SEARCH_WEB_VERIFY=true
SEARCH_PROVIDER=
SERPER_API_KEY=
SERPER_MAX_RPS=10

# Durable report/evidence objects. Prefer workload identity; do not put static
# cloud access keys in this file.
ARTIFACT_S3_BUCKET=
ARTIFACT_KMS_KEY_ID=
ARTIFACT_S3_PREFIX=artifacts/
ARTIFACT_URL_TTL_SECONDS=900

# Production governance maintenance. All identifiers are real AWS resources and every external
# erasure endpoint is verified at worker startup; there is no no-op adapter fallback.
AWS_ACCOUNT_ID=
GOVERNANCE_HMAC_KMS_KEY_ID=
AUDIT_SIGNING_KMS_KEY_ID=
AUDIT_SIGNING_ALGORITHM=ECDSA_SHA_256
AUDIT_EXPORT_S3_BUCKET=
AUDIT_EXPORT_KMS_KEY_ID=
AUDIT_EXPORT_S3_PREFIX=sentinel-audit-anchors/
AUDIT_RETENTION_DAYS=2555
AUDIT_LEGAL_BASIS_REFERENCE=
BACKUP_RETENTION_DAYS=2555
BACKUP_LEGAL_BASIS_REFERENCE=
# Include every primary and DR Vault-Locked vault, e.g. [{"region":"us-east-1","name":"prod-sentinel-vault"}]
GOVERNANCE_BACKUP_VAULTS=
# Include every source/replica artifact bucket and immutable KMS key ARN.
GOVERNANCE_ARTIFACT_BUCKETS=
GOVERNANCE_BULLMQ_QUEUES=["store-presence-deep-scan","distrokid-catalog-index","distrokid-plan-chunks","distrokid-release-chunk","distrokid-retry-failed","distrokid-reconcile","distrokid-finalize"]
GOVERNANCE_MAINTENANCE_INTERVAL_MS=300000
GOVERNANCE_ADAPTER_BATCH_SIZE=100
GOVERNANCE_EXTERNAL_TIMEOUT_MS=10000
GOVERNANCE_AWS_TIMEOUT_MS=5000
GOVERNANCE_AWS_MAX_ATTEMPTS=3
GOVERNANCE_DATABASE_POOL_MAX=10
KEYCLOAK_ADMIN_BASE_URL=
KEYCLOAK_ERASURE_CLIENT_ID=
KEYCLOAK_ERASURE_CLIENT_SECRET_ARN=
KEYCLOAK_ERASURE_CLIENT_SECRET_JSON_KEY=
OBSERVABILITY_ERASURE_URL=
OBSERVABILITY_ERASURE_READINESS_URL=
OBSERVABILITY_ERASURE_TOKEN_SECRET_ARN=
OBSERVABILITY_ERASURE_TOKEN_SECRET_JSON_KEY=

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=artist-catalog-sentinel

# --- Google sign-in (Keycloak identity provider) ----------------------------
# Lets users create an account / sign in with Google. Create an OAuth 2.0 Client
# (type: Web application) in Google Cloud Console → APIs & Services → Credentials,
# then add this Authorized redirect URI:
#   http://localhost:8080/realms/sentinel/broker/google/endpoint
# The realm import (docker/keycloak/realm-sentinel.json) reads these via env
# substitution, so the SECRET stays here (gitignored), never in the tracked realm JSON.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# Local development stack (docker-compose.yml)
# Required ONLY by the local Compose stack, which provisions its own Postgres
# and Keycloak. Managed production supplies these through the platform (managed
# DB credentials inside the *_DATABASE_URL values, Keycloak admin via the
# identity platform) and never reads them. The local stack fails to start until
# each is set - compose uses the ${VAR:?} guard, so there are no weak defaults.
# ============================================================================
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# Confidential Keycloak client the worker uses for governance/erasure calls.
KEYCLOAK_WORKER_CLIENT_SECRET=
# Local HMAC signing key for governance when KMS is not used (local/dev only;
# production uses GOVERNANCE_HMAC_KMS_KEY_ID instead).
GOVERNANCE_HMAC_LOCAL_KEY=

# Keycloak client redirect / post-logout URIs, consumed by the realm import
# (docker/keycloak/realm-sentinel.json) via env substitution. Space- or
# comma-separated exact URIs; use your real public origin in production, e.g.
# https://app.example.com/* . Local stack defaults to http://localhost:3000/*
WEB_REDIRECT_URIS=
WEB_POST_LOGOUT_REDIRECT_URIS=

# DistroKid catalogue-read tuning. Leave blank to use the code defaults shown.
DISTROKID_RELEASE_CHUNK_SIZE=      # releases per batch (default 20)
DISTROKID_RELEASE_CONCURRENCY=     # parallel release fetches (default 4, clamped 1..8)
DISTROKID_REQUEST_MIN_DELAY_MS=    # minimum pacing between browser requests (default 750)
DISTRIBUTOR_SESSION_REUSE=         # truthy to reuse an active Steel session across steps
DISTROKID_LYRIC_PASS=              # truthy to run the per-store lyric pass after a scrape
CATALOG_SCAN_WEB_LIMIT=            # max releases for web-active catalogue scans (default 8)

# Use the official YouTube Data API (needs YOUTUBE_API_KEY) instead of the
# keyless fallback. Truthy to enable.
YOUTUBE_USE_API=

# --- Development / debug only (keep disabled and unset in production) --------
# Guarded dev-only re-scan endpoint; when enabled it requires DEV_RESCAN_SECRET.
ENABLE_DEV_RESCAN=false
DEV_RESCAN_SECRET=
# Write captured DistroKid album DOM to this directory for debugging.
DISTROKID_ALBUM_CAPTURE_DIR=
DISTROKID_ALBUM_CAPTURE_UUID=

# --- Catalogue assistant (inspector chat) -----------------------------------
# The assistant answers navigation questions and questions about the caller's own
# scan results, grounded in their saved audits. Uses the OpenAI-compatible
# chat-completions API. Set OPENAI_API_KEY to enable it; without a key the
# assistant reports itself disabled and nothing else is affected. Usage is billed.
OPENAI_API_KEY=
# Optional: override the model (default gpt-4o-mini; e.g. o4-mini / o3 / gpt-4o).
OPENAI_MODEL=
# Optional: OpenAI-compatible base URL (default https://api.openai.com/v1).
OPENAI_BASE_URL=
# Optional: cap tokens per reply (default 1024).
ASSISTANT_MAX_TOKENS=
# Password for the dedicated assistant database container (separate from the main Postgres).
# The API stores tenant-scoped assistant conversations here via ASSISTANT_DATABASE_URL (set in compose).
ASSISTANT_DB_PASSWORD=
