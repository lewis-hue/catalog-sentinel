# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# Production image for the compiled API, compiled workers, migration job, and
# traced Next.js web server. It deliberately contains no Chromium, X server,
# VNC, noVNC, Browserless, TypeScript runner, or test/build toolchain. The only
# production browser path is an external Steel session.
FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS dependencies

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# Prisma's native engine needs OpenSSL at generate/runtime. CA roots are also
# required for TLS to Keycloak, Steel, Postgres/Redis proxies, and DSP APIs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

# Copy every workspace manifest before npm ci so dependency installation is
# cacheable and workspace links are constructed correctly.
COPY package.json package-lock.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/queue-client/package.json ./packages/queue-client/
COPY packages/persistence/package.json ./packages/persistence/
COPY packages/search-store/package.json ./packages/search-store/
COPY packages/core/package.json ./packages/core/
COPY packages/matching/package.json ./packages/matching/
COPY packages/adapters/package.json ./packages/adapters/
COPY packages/security/package.json ./packages/security/
COPY packages/reports/package.json ./packages/reports/
COPY packages/db/package.json ./packages/db/
COPY packages/engine/package.json ./packages/engine/
COPY packages/browser-assist/package.json ./packages/browser-assist/
COPY packages/browser-link/package.json ./packages/browser-link/
COPY packages/steel/package.json ./packages/steel/
COPY packages/scanner/package.json ./packages/scanner/
COPY packages/shared-ui/package.json ./packages/shared-ui/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/

# Development dependencies exist only in build stages. Playwright's install
# scripts remain disabled so no browser binary is downloaded.
RUN npm ci --include=dev --ignore-scripts \
    && npm cache clean --force

FROM dependencies AS build
COPY packages ./packages
COPY apps ./apps
COPY scripts/build-production-runtime.mjs ./scripts/build-production-runtime.mjs
COPY tsconfig.base.json tsconfig.json vitest.config.ts ./

# Generate the native Prisma client for this image. Playwright's browser install
# scripts stay disabled: connectOverCDP talks to Steel and needs no local browser.
RUN npm run --workspace @sentinel/db db:generate

# Bundle every first-party API/worker module and its portable JavaScript
# dependencies. Only Playwright (Steel's CDP client), Prisma's native client,
# and explicitly optional integrations remain external.
RUN node scripts/build-production-runtime.mjs

# Next rewrites same-origin /api requests to the private API service. Authentication
# settings remain runtime-only and are not embedded in the client bundle. Next's
# supported standalone output traces only files reachable by the production server.
ENV NODE_ENV=production \
    API_PROXY_TARGET=http://scanner:4000
RUN npm run --workspace apps/web build

# The runtime dependency set is derived from the lockfile-backed installation,
# then pruned offline to the two intentionally external runtime families. This
# retains Prisma migrations and the browserless Playwright CDP client without
# carrying tsx, TypeScript, Vitest, Next's compiler, or other development tools.
FROM dependencies AS runtime-dependencies
COPY packages/db/prisma ./packages/db/prisma
COPY scripts/copy-production-dependencies.mjs ./scripts/copy-production-dependencies.mjs
RUN node node_modules/prisma/build/index.js generate --schema packages/db/prisma/schema.prisma \
    && node scripts/copy-production-dependencies.mjs \
      /app/node_modules /app/runtime-node_modules @prisma/client prisma playwright

FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    HOSTNAME=0.0.0.0 \
    API_PROXY_TARGET=http://scanner:4000 \
    NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

# Native/runtime dependencies for the compiled API, worker, and migration job.
COPY --from=runtime-dependencies --chown=node:node /app/runtime-node_modules ./node_modules

# Next's standalone trace includes its production server and only the modules
# the server can reach. Static assets are intentionally copied separately.
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static

# Compiled entrypoints and minimal manifests preserve the existing Compose
# commands while ensuring npm invokes node, never tsx.
COPY --from=build --chown=node:node /app/dist/production-runtime/api.cjs ./api.cjs
COPY --from=build --chown=node:node /app/dist/production-runtime/worker.cjs ./worker.cjs
COPY --from=build --chown=node:node /app/dist/production-runtime/package.json ./package.json
COPY --from=build --chown=node:node /app/dist/production-runtime/apps/web/package.json ./apps/web/package.json
COPY --from=build --chown=node:node /app/dist/production-runtime/packages/db/package.json ./packages/db/package.json
COPY --from=build --chown=node:node /app/packages/db/prisma ./packages/db/prisma

# Resolve every static dependency from the final filesystem. The internal flag
# suppresses startup side effects; it is never set by the committed task definitions.
RUN SENTINEL_INTERNAL_MODULE_LOAD_ONLY=1 node ./api.cjs \
    && SENTINEL_INTERNAL_MODULE_LOAD_ONLY=1 node ./worker.cjs

# Next conservatively traces the disabled image optimizer and build pipeline;
# Prisma traces its optional TypeScript peer. Remove those exact package roots,
# then recursively prove no build/test tool, vulnerable PostCSS/Sharp package,
# or local browser executable remains. Read-only mounts keep both scripts out of
# the image layers.
RUN --mount=type=bind,source=scripts/prune-production-image.mjs,target=/tmp/prune-production-image.mjs,readonly \
    --mount=type=bind,source=scripts/assert-production-image.mjs,target=/tmp/assert-production-image.mjs,readonly \
    node /tmp/prune-production-image.mjs \
    && node /tmp/assert-production-image.mjs

# The image-level account is non-root. Compose adds a read-only root filesystem,
# drops Linux capabilities, and supplies only bounded tmpfs scratch space.
USER node
EXPOSE 3000 4000

CMD ["node", "api.cjs"]
